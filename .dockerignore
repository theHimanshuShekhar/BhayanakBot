# Installed and built inside the image. `**/` matters: web/node_modules and any other nested copy from the host
# must never reach a COPY.
**/node_modules
**/dist
**/.astro
**/coverage
**/*.log

# Secrets and local config. `.env.example` is documentation, not build input.
**/.env*

# Repository metadata and tooling the image never reads.
.git
.gitignore
.github
.githooks
.claude
.impeccable
.vscode
.idea
.worktrees

# Not part of any image: tests, docs, and the Docker files themselves.
tests
docs
thoughts
*.md
vitest.config.ts
drizzle.config.ts
tsconfig.test.json
biome.json
renovate.json
Dockerfile
docker-compose.yml
