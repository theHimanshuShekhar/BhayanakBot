DISCORD_TOKEN=your_bot_token_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bhayanakbot
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bhayanakbot_test
POSTGRES_PASSWORD=postgres

# opencode Zen is the only LLM provider, for responders, summaries, and personality generation.
ZEN_API_KEY=
# Must be true before Discord message content is sent to Zen; otherwise AI features stay silent.
ZEN_ALLOW_DISCORD_CONTENT=false
ZEN_BASE_URL=https://opencode.ai/zen/go/v1
ZEN_MODEL=deepseek-v4-flash
ZEN_TIMEOUT_MS=30000

WEB_PORT=3000
PUBLIC_BOT_INVITE_URL=https://discord.com/oauth2/authorize
PUBLIC_STATS_INTERVAL_MS=300000
DASHBOARD_PRESENCE_INTERVAL_MS=60000
NODE_ENV=development

TARGET_GUILD_ID=199168135935295488
TARGET_TEXT_CHANNEL_ID=199168135935295488
GUESS_WHO_CHANNEL_ID=199168135935295488
GUESS_WHO_BACKFILL_LIMIT=1000
# Optional privileged Discord user ID. Leave blank to disable owner bypasses.
BOT_OWNER_ID=

# Palworld live player tracker. The tracker runs as soon as the admin key is set.
# PALWORLD_API_URL defaults to http://127.0.0.1:8212 — set it explicitly when the bot
# runs in Docker, where localhost is the container rather than the Palworld host.
PALWORLD_API_URL=
PALWORLD_ADMIN_KEY=
# Minecraft live player tracker. The tracker runs when the RCON password is set.
# Enable RCON in the Java server's server.properties with enable-rcon=true and
# rcon.port=25575. Defaults to 127.0.0.1:25575; if the bot runs in Docker and
# Minecraft runs outside that container, set MINECRAFT_RCON_HOST accordingly.
MINECRAFT_RCON_HOST=
MINECRAFT_RCON_PORT=
MINECRAFT_RCON_PASSWORD=

YOUTUBE_COOKIE=
