DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bhayanakbot
VALKEY_URL=redis://localhost:6379
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
ZEN_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/go/v1
ZEN_MODEL=deepseek-v4-flash
WEB_PORT=3000
NODE_ENV=development
GUESS_WHO_CHANNEL_ID=199168135935295488
GUESS_WHO_BACKFILL_LIMIT=1000
YOUTUBE_OAUTH_CREDENTIALS=  # token string from discord-player-youtubei objectToToken(generateOauthTokens())
YOUTUBE_COOKIE=

# Voice responder (optional — bot works without it)
# Self-hosted STT: whisper.cpp binary path and model
WHISPER_BINARY=whisper-cli
WHISPER_MODEL=ggml-base.en.bin

# Self-hosted TTS: Piper binary path and model
PIPER_BINARY=piper
PIPER_MODEL=en_US-lessac-medium.onnx
