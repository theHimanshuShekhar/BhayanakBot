---
import { getCollection } from "astro:content";
import BotEmbed from "~/components/BotEmbed.astro";
import ChatMessage from "~/components/ChatMessage.astro";
import Sticker from "~/components/Sticker.astro";
import { COMMANDS, findCategory, slugForCommand } from "~/data/commands";
import SiteLayout from "~/layouts/SiteLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
	const entries = await getCollection("commands");
	const richBySlug = new Map(entries.map((entry) => [entry.id.replace(/\.mdx$/, ""), entry]));
	return COMMANDS.map((command) => ({
		params: { slug: command.slug },
		props: { command, rich: richBySlug.get(command.slug) ?? null },
	}));
}

const { command, rich } = Astro.props;
const category = findCategory(command.category);
const data = rich?.data;
const args =
	data?.syntax.args ??
	(command.syntax.match(/[<[][^>\]]+[>\]]/g) ?? []).map((part: string) => ({
		n: part.slice(1, -1),
		d: `${part.slice(1, -1)} parameter`,
		req: part.startsWith("<"),
		t: "string",
	}));
const related =
	data?.related ??
	COMMANDS.filter((item) => item.category === command.category && item.slug !== command.slug)
		.slice(0, 3)
		.map((item) => ({ n: item.name, d: item.description }));
const subcommands = Object.entries(command.subcommands ?? {});
---

<SiteLayout title={`${command.name} — BhayanakBot`} active="commands">
	<div class="flex min-h-screen max-md:block">
		<aside class="sticky top-[53px] h-[calc(100vh-53px)] w-60 self-start overflow-y-auto border-r-2 border-border px-8 pt-8 pb-8 max-md:hidden">
			<a href="/commands" class="a-ghost mb-6 inline-flex px-1.5 py-1 font-mono text-[12px] text-fg/60">← all commands</a>
			<div class="mb-3 font-mono text-[10px] uppercase tracking-[1px] text-fg/40">on this page</div>
			{["overview", "syntax", subcommands.length ? "subcommands" : null, data?.variants ? "variants" : null, data?.examples?.length ? "examples" : null, "related"].filter(Boolean).map((section, index) => (
				<a href={`#${section}`} class:list={["block py-1.5 font-mono text-[12px]", index === 0 ? "text-accent" : "text-fg/55"]}>{section}</a>
			))}
		</aside>

		<article class="min-w-0 max-w-[920px] flex-1 px-12 pt-8 pb-20 max-md:max-w-none max-md:px-5 max-md:pt-6 max-md:pb-16">
			<div class="mb-2 font-mono text-[11px] uppercase tracking-[1px] text-fg/40">{category?.label ?? command.category}</div>
			<div class="mb-2 flex flex-wrap items-baseline gap-3">
				<h1 class="m-0 break-all font-mono text-[88px] font-black -tracking-[3px] text-accent max-md:text-[56px] max-md:-tracking-[2px]">{command.name}</h1>
				{(data?.tags ?? ["CATALOG"]).map((tag: string) => <Sticker rot={-4}>{tag}</Sticker>)}
			</div>
			<p id="overview" class="mt-3 mb-6 max-w-[660px] whitespace-pre-line text-[18px] leading-[1.55] text-fg/75 max-md:text-[15px]">{data?.summary ?? command.description}</p>
			{!data && <div class="mb-6 border-2 border-border bg-bg-panel px-5 py-3 font-mono text-[12px] text-fg/55"><strong class="text-accent-yellow">Catalog-only entry.</strong> This command is part of the current bot catalog. Add rich MDX docs in <code>web/src/content/commands/{command.slug}.mdx</code> when its behavior needs a full guide.</div>}

			<section id="syntax" class="mb-8 border-2 border-border bg-bg-panel px-6 py-5 max-md:px-4.5 max-md:py-4">
				<div class="mb-2.5 font-mono text-[11px] uppercase tracking-[1px] text-fg/40">syntax</div>
				<code class="mb-4 block break-words font-mono text-[16px] text-fg max-md:text-[14px]"><span class="text-accent">{data?.syntax.cmd ?? command.name}</span>{args.map((arg: { n: string; req: boolean }) => <span class={arg.req ? "text-accent-yellow" : "text-fg/40"}> {arg.req ? "<" : "["}{arg.n}{arg.req ? ">" : "]"}</span>)}</code>
				{args.length > 0 && <div class="grid grid-cols-[auto_1fr_auto] gap-x-5 gap-y-2 text-[13px] max-md:grid-cols-1 max-md:gap-y-1">{args.map((arg: { n: string; d: string; req: boolean; t: string }) => <><code class:list={["font-mono", arg.req ? "text-accent-yellow" : "text-fg/55"]}>{arg.n}</code><span class="text-fg/70">{arg.d}</span><code class="font-mono text-[11px] text-fg/40">{arg.req ? "required" : "optional"} · {arg.t}</code></>)}</div>}
			</section>

			{subcommands.length > 0 && <section id="subcommands"><h2 class="mt-10 mb-4 text-[28px] font-black -tracking-[0.5px] uppercase max-md:text-[22px]">Subcommands</h2><div class="mb-10 grid grid-cols-2 border-2 border-border max-md:grid-cols-1">{subcommands.map(([name, meta], index) => <div class:list={["bg-bg-panel px-5 py-5", index % 2 === 0 && index < subcommands.length - 1 && "border-r-2 border-border max-md:border-r-0", index < subcommands.length - 2 && "border-b-2 border-border", "max-md:border-b-2 max-md:border-border"]}><code class="font-mono text-[15px] font-bold text-accent">{command.name} {name}</code><div class="mt-2.5 text-[13px] leading-[1.45] text-fg/65">{meta.summary}</div>{meta.examples.length > 0 && <code class="mt-3 block break-words font-mono text-[11px] text-fg/45">{meta.examples[0]}</code>}</div>)}</div></section>}

			{data?.variants && <section id="variants"><h2 class="mt-10 mb-4 text-[28px] font-black -tracking-[0.5px] uppercase max-md:text-[22px]">Variants</h2><div class="mb-10 grid grid-cols-3 border-2 border-border max-md:grid-cols-1">{data.variants.map((variant, index, all) => <div class:list={["bg-bg-panel px-5 py-5", index < all.length - 1 && "border-r-2 border-border max-md:border-r-0 max-md:border-b-2"]}><code class="font-mono text-[15px] font-bold text-accent">{variant.n}</code><div class="mt-3 mb-1 flex items-center gap-2"><span class="font-mono text-[10px] uppercase tracking-[0.5px] text-fg/40">risk</span><div class="h-1 flex-1 overflow-hidden rounded-sm bg-fg/[0.08]"><div class="h-full bg-accent" style={`width: ${variant.risk}%;`}></div></div><span class="font-mono text-[11px] font-bold text-accent">{variant.risk}%</span></div><div class="mb-2.5 font-mono text-[12px] text-fg/60">{variant.pay} · {variant.stat}</div><div class="text-[12px] leading-[1.45] text-fg/55">{variant.d}</div></div>)}</div></section>}

			{data?.examples?.length > 0 && <section id="examples"><h2 class="mt-10 mb-4 text-[28px] font-black -tracking-[0.5px] uppercase max-md:text-[22px]">Examples</h2>{data.examples.map((example, index) => <div class="mb-4.5 border-2 border-border bg-bg-panel"><div class="flex items-center justify-between border-b border-border px-3.5 py-2.5"><span class="font-mono text-[11px] text-fg/50">example {String(index + 1).padStart(2, "0")} · {example.label}</span><Sticker size="sm" rot={0} bg={example.tagBg} color="var(--color-bg)">{example.tag}</Sticker></div><ChatMessage user={example.user} userColor={example.userColor} time={example.time}><code class="font-mono text-accent">{data.syntax.cmd}</code> {example.input}</ChatMessage><ChatMessage user="BhayanakBot" bot time={example.time} reactions={example.reactions}>{example.botSays}<BotEmbed accent={example.embedAccent} title={example.embedTitle} footer={example.embedFooter}><div class="grid grid-cols-2 gap-2">{example.embedRows.map((row) => <div><span class="text-fg/50">{row[0]}</span> <strong style={row[2] ? `color: ${row[2]};` : ""}>{row[1]}</strong></div>)}</div></BotEmbed></ChatMessage></div>)}</section>}

			<section id="related">
				<h2 class="mt-10 mb-4 text-[28px] font-black -tracking-[0.5px] uppercase max-md:text-[22px]">Related</h2>
				<div class="mb-8 grid grid-cols-3 border-2 border-border max-md:grid-cols-1">
					{related.map((item, index) => <a href={`/commands/${slugForCommand(item.n)}`} class:list={["a-card-lift bg-bg-panel px-5 py-4.5 text-fg", index < related.length - 1 && "border-r-2 border-border max-md:border-r-0 max-md:border-b-2"]}><code class="font-mono text-[15px] font-bold text-accent">{item.n}</code><div class="mt-1.5 text-[12px] text-fg/60">{item.d}</div></a>)}
				</div>
			</section>
		</article>
	</div>
</SiteLayout>
