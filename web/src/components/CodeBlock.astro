---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="overflow-hidden border-2 border-border bg-bg-panel">
	<div class="flex items-center gap-2 border-b border-border bg-bg-panel-2 px-4 py-2.5">
		<span class="h-2.5 w-2.5 rounded-full bg-[#ef4444]"></span>
		<span class="h-2.5 w-2.5 rounded-full bg-[#facc15]"></span>
		<span class="h-2.5 w-2.5 rounded-full bg-[#22c55e]"></span>
		<span class="ml-2 font-mono text-[11px] text-fg/50">{title}</span>
	</div>
	<pre class="m-0 overflow-x-auto p-4 font-mono text-[12px] leading-[1.7] text-fg/75"><slot /></pre>
</div>
