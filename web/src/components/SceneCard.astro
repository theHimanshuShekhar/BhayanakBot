---
import Sticker from "./Sticker.astro";

interface Props {
	channel: string;
	tag: string;
	tagColor?: string;
}

const { channel, tag, tagColor = "var(--color-accent)" } = Astro.props;
---

<section class="overflow-hidden border-2 border-border bg-bg-panel">
	<div class="flex items-center gap-2 border-b border-border bg-bg-panel-2 px-3.5 py-2.5">
		<span class="font-mono text-[11px] text-fg/50"># {channel}</span>
		<div class="flex-1"></div>
		<Sticker size="sm" rot={0} bg={tagColor} color="var(--color-bg)">{tag}</Sticker>
	</div>
	<slot />
</section>
