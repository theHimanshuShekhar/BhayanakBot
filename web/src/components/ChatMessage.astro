---
import BotAvatar from "./BotAvatar.astro";

interface Reaction {
	e: string;
	n: number;
}

interface Props {
	user: string;
	userColor?: string;
	time: string;
	bot?: boolean;
	reactions?: Reaction[];
}

const { user, userColor = "var(--color-accent)", time, bot = false, reactions = [] } = Astro.props;
const isBot = bot || user === "BhayanakBot";
---

<div class="flex items-start gap-3 px-3 py-2.5 font-display max-md:gap-2.5 max-md:px-2.5 max-md:py-2">
	{isBot ? (
		<BotAvatar size={38} />
	) : (
		<span
			class="flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-full border-2 border-bg font-mono text-[14px] font-extrabold text-bg"
			style={`background: ${userColor};`}
		>
			{user[0]?.toUpperCase()}
		</span>
	)}
	<div class="min-w-0 flex-1">
		<div class="mb-0.5 flex flex-wrap items-baseline gap-2">
			<span class="text-[14px] font-bold text-fg max-md:text-[13px]">{user}</span>
			{isBot && <span class="rounded-[3px] bg-accent px-1.5 py-px font-mono text-[10px] font-extrabold text-bg">BOT</span>}
			<span class="font-mono text-[11px] text-fg/50">{time}</span>
		</div>
		<div class="break-words text-[14px] leading-[1.5] text-fg/90 max-md:text-[13px]">
			<slot />
		</div>
		{reactions.length > 0 && (
			<div class="mt-1.5 flex flex-wrap gap-1">
				{reactions.map((reaction) => (
					<span
						class="a-react-pill flex items-center gap-1 rounded-[10px] px-1.5 py-0.5 font-mono text-[12px] text-fg"
						style="background: color-mix(in oklab, var(--color-accent) 15%, transparent); border: 1px solid color-mix(in oklab, var(--color-accent) 40%, transparent);"
					>
						{reaction.e}<span class="text-fg/60">{reaction.n}</span>
					</span>
				))}
			</div>
		)}
	</div>
</div>
