---
interface Props {
	size?: number;
}

const { size = 34 } = Astro.props;
---

<span
	class="relative inline-flex shrink-0 items-center justify-center rounded-full border-2 border-bg"
	style={`width: ${size}px; height: ${size}px; background: var(--bot-grad);`}
	aria-hidden="true"
>
	<span class="absolute top-[31%] left-[28%] h-1.5 w-1.5 rounded-full bg-bg"></span>
	<span class="absolute top-[31%] right-[28%] h-1.5 w-1.5 rounded-full bg-bg"></span>
	<span class="absolute bottom-[26%] h-1 w-[34%] rounded-full bg-bg"></span>
</span>
